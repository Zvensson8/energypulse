# Supabase (public – safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Liljeblads bridge (read components + property list)
# LILJEBLADS_WEBHOOK_URL=https://YOUR_REF.supabase.co/functions/v1/crewai-webhook
# LILJEBLADS_API_KEY=lbl_your_key_with_list_properties_and_list_components
# LILJEBLADS_ANON_KEY=your_liljeblads_publishable_or_anon_key
# LILJEBLADS_APP_URL=https://liljeblads.vercel.app
# ENERGYPULSE_BRIDGE_SECRET=generate-a-long-random-secret

# Logging
LOG_LEVEL=info

# E2E / Playwright
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=...
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1

# Performance benches
# PERF_PROPERTIES=180
# PERF_YEARS=8
# PERF_DASHBOARD_TARGET_MS=3000
# PERF_IMPORT_TARGET_MS=60000
